# Database
# For local dev, SQLite is used by default (no setup required).
# For production, switch to Postgres:
# DATABASE_URL=postgresql+psycopg2://insightai:insightai@localhost:5432/insightai
DATABASE_URL=sqlite:///./insightai.db

# App
ENVIRONMENT=development
MAX_UPLOAD_MB=50

# AI (used starting Phase 2 - not required for Phase 1)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
